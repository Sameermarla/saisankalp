# =================================================================
#   Sai Sankalp — Environment Configuration
# =================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# =================================================================

# --- Server ---
PORT=8000
ENV=development
# Comma-separated list of allowed origins for CORS (no trailing slash)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Firebase (Cloud Firestore) ---
# Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# Your Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# --- SMTP Email (Gmail App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=your-gmail-address@gmail.com
SMTP_SENDER_PASSWORD=your-gmail-app-password-here
SMTP_RECEIVER_EMAIL=host-receipt-email@gmail.com

# --- Admin ---
ADMIN_EMAIL=saisameermarla@gmail.com
ADMIN_CONTACT=9361483584

# --- Security ---
PASSWORD_SALT=SAI_SANKALP_SECURE_SALT_2026
